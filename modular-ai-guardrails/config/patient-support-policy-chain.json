  {
    "name": "regex-guardrail",
    "version": "v1",
    "paths": [
      {
        "path": "/chat/completions",
        "methods": [
          "POST"
        ],
        "params": {
          "request": {
            "enabled": true,
            "regex": "(?i)(?:\\bDNI\\s*[:#-]?\\s*[0-9]{1,2}(?:\\.[0-9]{3}){2}\\b|\\b(?:CUIL|CUIT)\\s*[:#-]?\\s*[0-9]{2}-[0-9]{8}-[0-9]\\b)",
            "jsonPath": "$.messages[-1].content",
            "invert": true,
            "showAssessment": false
          }
        }
      }
    ]
  },
