# Registration data from WSO2 AI Workspace when adding healthcare-ai-security-gateway
GATEWAY_CONTROLPLANE_HOST=<your-ai-workspace-control-plane-host>
GATEWAY_REGISTRATION_TOKEN=<one-time-registration-token>

# Use the same high-entropy secret in the BFF and Gateway runtime. Never commit the real value.
HELIOS_CONTEXT_SIGNING_KEY=<generate-at-least-32-random-bytes>

# ap gateway image build currently emits image names; override these if your output differs.
GATEWAY_CONTROLLER_IMAGE=ghcr.io/wso2/api-platform/gateway-v1.1.0-gateway-controller:1.1.0
GATEWAY_RUNTIME_IMAGE=ghcr.io/wso2/api-platform/gateway-v1.1.0-gateway-runtime:1.1.0
