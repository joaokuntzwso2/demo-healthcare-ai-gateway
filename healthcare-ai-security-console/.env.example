# Runtime configuration is generated automatically by ./run.sh.
# Do not copy real secrets into this file.
LLM_MODE=gateway
PORT=5173
WSO2_AI_GATEWAY_URL=https://localhost:<detected-port>
WSO2_CLINICAL_PROXY_CONTEXT=/default/clinical-ai-secure
WSO2_PATIENT_PROXY_CONTEXT=/default/patient-support-ai-secure
WSO2_API_KEY_HEADER=X-API-Key
WSO2_DEFAULT_MODEL=gpt-4o-mini
WSO2_TLS_INSECURE=true

# Generated on every ./run.sh and written to root .helios.env + this directory's .env.local:
# WSO2_PROVIDER_ACCESS_KEY=<generated>
# WSO2_CLINICAL_PROXY_API_KEY=<generated>
# WSO2_PATIENT_PROXY_API_KEY=<generated>
# HELIOS_CONTEXT_SIGNING_KEY=<generated>
# HELIOS_PSEUDONYM_KEY=<generated>
# HELIOS_APPROVAL_KEY=<generated>
# HELIOS_KNOWLEDGE_SIGNING_KEY=<generated>
