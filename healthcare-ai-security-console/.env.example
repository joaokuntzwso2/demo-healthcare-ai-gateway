# Default local mode: no external model or Gateway required.
LLM_MODE=deterministic
PORT=5173

# Full WSO2 AI Gateway mode
# LLM_MODE=gateway
# WSO2_AI_GATEWAY_URL=https://localhost:8443
# WSO2_CLINICAL_PROXY_API_KEY=<generated-key-for-clinical-ai-secure>
# WSO2_PATIENT_PROXY_API_KEY=<generated-key-for-patient-support-ai-secure>
# WSO2_TLS_INSECURE=true

# Same high-entropy value must be supplied to the Gateway runtime.
HELIOS_CONTEXT_SIGNING_KEY=<generate-with-openssl-rand-hex-32>

# Demo-only local cryptographic separation. Replace for any non-demo use.
HELIOS_PSEUDONYM_KEY=<random-value>
HELIOS_APPROVAL_KEY=<random-value>
HELIOS_KNOWLEDGE_SIGNING_KEY=<random-value>
